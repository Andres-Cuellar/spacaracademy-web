---
import BaseLayout from '../layouts/BaseLayout.astro';
import GhlForm from '../components/GhlForm.astro';

// Formulario de GoHighLevel ("Formulario JG")
const ghlFormId = 'MRYiwnOEDo4xIEUuBUKW';
---

<BaseLayout
  title="Contacto · SpaCar Academy"
  description="Contáctanos por WhatsApp, email o Instagram, o agenda tu llamada gratuita con SpaCar Academy."
  active="contacto"
>
  <main>

    <!-- ============ PAGE HERO ============ -->
    <section class="text-light relative jarallax">
      <img src="/images/contacto-hero.jpg" class="jarallax-img" alt="" />
      <div class="de-overlay-color op-7"></div>
      <div class="container relative z-2">
        <div class="row justify-content-center text-center">
          <div class="col-lg-8">
            <div class="spacer-single"></div>
            <span class="vsl-eyebrow wow fadeInUp">Contacto</span>
            <h1 class="mt-3 mb-2 wow fadeInUp" data-wow-delay=".1s">Hablemos de tu detailing</h1>
            <p class="lead wow fadeInUp" data-wow-delay=".2s">¿Dudas antes de agendar? Escríbenos y te respondemos.</p>
            <div class="spacer-single"></div>
          </div>
        </div>
      </div>
      <div class="gradient-edge-bottom"></div>
    </section>

    <!-- ============ CONTACTO ============ -->
    <section>
      <div class="container">
        <div class="row g-5">
          <!-- Info -->
          <div class="col-lg-5">
            <div class="subtitle id-color mb-3 wow fadeInUp">Datos de contacto</div>
            <h2 class="mb-4 wow fadeInUp" data-wow-delay=".1s">Elige el canal que prefieras</h2>

            <div class="vsl-contact-item wow fadeInUp">
              <div class="ico"><i class="fa-brands fa-whatsapp"></i></div>
              <div>
                <div class="lbl">WhatsApp</div>
                <a class="val" href="https://wa.me/13525572136" target="_blank" rel="noopener">+1 (352) 557-2136</a>
              </div>
            </div>
            <div class="vsl-contact-item wow fadeInUp" data-wow-delay=".1s">
              <div class="ico"><i class="fa-solid fa-envelope"></i></div>
              <div>
                <div class="lbl">Email</div>
                <a class="val" href="mailto:hola@spacaracademy.com">hola@spacaracademy.com</a>
              </div>
            </div>
            <div class="vsl-contact-item wow fadeInUp" data-wow-delay=".2s">
              <div class="ico"><i class="fa-brands fa-instagram"></i></div>
              <div>
                <div class="lbl">Instagram</div>
                <a class="val" href="https://instagram.com/spacaracademy" target="_blank" rel="noopener">@spacaracademy</a>
              </div>
            </div>

            <div class="spacer-20"></div>
            <div class="vsl-note wow fadeInUp">
              ¿Ya estás listo para escalar? <a href="/registro.html" class="id-color fw-bold">Agenda tu llamada gratuita →</a>
            </div>
          </div>

          <!-- Formulario -->
          <div class="col-lg-7">
            <div class="subtitle id-color mb-3 wow fadeInUp">Envíanos un mensaje</div>
            <h2 class="mb-4 wow fadeInUp" data-wow-delay=".1s">Cuéntanos sobre tu negocio</h2>

            <div class="wow fadeInUp" data-wow-delay=".2s">
              <GhlForm formId={ghlFormId} formName="Formulario JG" height="711px" title="Formulario JG" />
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>
