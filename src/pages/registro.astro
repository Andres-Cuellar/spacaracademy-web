  <script is:inline>
    (function () {
      var FORM_SRC = "https://api.leadconnectorhq.com/widget/form/MRYiwnOEDo4xIEUuBUKW";
      var overlay = null;

      function buildOverlay() {
        if (overlay) return overlay;

        overlay = document.createElement("div");
        overlay.id = "scaModal";
        overlay.style.cssText =
          "position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.82);" +
          "display:none;align-items:flex-start;justify-content:center;z-index:999999;" +
          "padding:24px 16px;overflow-y:auto;";

        var box = document.createElement("div");
        box.style.cssText =
          "position:relative;background:#fff;max-width:560px;width:100%;border-radius:14px;" +
          "padding:52px 20px 20px;margin:auto;box-shadow:0 24px 70px rgba(0,0,0,.55);";

        var close = document.createElement("button");
        close.innerHTML = "&times;";
        close.setAttribute("aria-label", "Cerrar");
        close.style.cssText =
          "position:absolute;top:12px;right:14px;width:40px;height:40px;border:none;" +
          "background:#0f0f0f;color:#fff;font-size:26px;line-height:1;border-radius:50%;" +
          "cursor:pointer;display:flex;align-items:center;justify-content:center;";
        close.onmouseover = function () { close.style.background = "#C8007C"; };
        close.onmouseout = function () { close.style.background = "#0f0f0f"; };

        var title = document.createElement("h3");
        title.style.cssText =
          "font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:23px;" +
          "line-height:1.18;color:#0f0f0f;text-align:center;margin:0 0 22px;" +
          "text-transform:uppercase;letter-spacing:.01em;";
        title.innerHTML =
          "<span style='display:block;color:#C8007C;font-size:18px;margin-bottom:8px;'>PASO 1:</span>" +
          "Registra tus datos para agendar tu llamada y descubrir el Sistema Llave en Mano para escalar tu " +
          "<span style='color:#35BAEE;'>detailing</span> a <span style='color:#C8007C;'>$25K</span>–" +
          "<span style='color:#C8007C;'>$30K</span> al mes sin tocar un solo carro.";

        var iframe = document.createElement("iframe");
        iframe.src = FORM_SRC;
        iframe.id = "inline-MRYiwnOEDo4xIEUuBUKW";
        iframe.title = "Formulario de registro SpaCar";
        iframe.setAttribute("data-form-id", "MRYiwnOEDo4xIEUuBUKW");
        iframe.style.cssText =
          "width:100%;min-height:640px;border:none;border-radius:8px;display:block;";

        box.appendChild(close);
        box.appendChild(title);
        box.appendChild(iframe);
        overlay.appendChild(box);
        document.body.appendChild(overlay);

        close.addEventListener("click", closeModal);
        overlay.addEventListener("click", function (e) {
          if (e.target === overlay) closeModal();
        });

        return overlay;
      }

      function openModal(e) {
        if (e) e.preventDefault();
        buildOverlay().style.display = "flex";
        document.body.style.overflow = "hidden";
      }

      function closeModal() {
        if (overlay) overlay.style.display = "none";
        document.body.style.overflow = "";
      }

      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape") closeModal();
      });

      document.querySelectorAll('a[href="/agenda"]').forEach(function (a) {
        a.addEventListener("click", openModal);
      });
    })();
  </script>

