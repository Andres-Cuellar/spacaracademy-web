---
import BaseLayout from '../layouts/BaseLayout.astro';

// Para agregar un post: sumá un objeto acá. La grilla se arma sola.
const posts = [
  { img: '/images/det-1.jpg', day: '12', month: 'Jul', cat: 'Estructura', title: 'Por qué facturas bien pero sigues atrapado en tu propio negocio', href: '/blog-single.html' },
  { img: '/images/det-2.jpg', day: '08', month: 'Jul', cat: 'Clientes', title: 'El motor de clientes: cómo dejar de depender del boca a boca', href: '/blog-single.html' },
  { img: '/images/det-3.jpg', day: '03', month: 'Jul', cat: 'Equipo', title: 'Cómo contratar tu primer detailer sin miedo a perder calidad', href: '/blog-single.html' },
  { img: '/images/det-4.jpg', day: '27', month: 'Jun', cat: 'Precios', title: 'Deja de competir por precio: cómo vender detailing premium', href: '/blog-single.html' },
  { img: '/images/det-5.jpg', day: '19', month: 'Jun', cat: 'Delegación', title: 'Los procesos que necesitas para salir del carro sin bajar el estándar', href: '/blog-single.html' },
  { img: '/images/det-6.jpg', day: '11', month: 'Jun', cat: 'Mentalidad', title: 'De técnico a dueño: el cambio que multiplica tu facturación', href: '/blog-single.html' },
];
const delays = ['0.0s', '0.15s', '0.3s'];
---

<BaseLayout
  title="Blog · SpaCar Academy"
  description="Ideas para escalar tu detailing: clientes en automático, equipo, delegación y operar como dueño."
  active="blog"
>
  <main>

    <!-- ============ PAGE HERO ============ -->
    <section class="text-light relative jarallax">
      <img src="/images/blog-hero.jpg" class="jarallax-img" alt="" />
      <div class="de-overlay-color op-7"></div>
      <div class="container relative z-2">
        <div class="row justify-content-center text-center">
          <div class="col-lg-8">
            <div class="spacer-single"></div>
            <span class="vsl-eyebrow wow fadeInUp">Blog</span>
            <h1 class="mt-3 mb-2 wow fadeInUp" data-wow-delay=".1s">Ideas para escalar tu detailing</h1>
            <p class="lead wow fadeInUp" data-wow-delay=".2s">Clientes en automático, equipo, delegación y la mentalidad de operar como dueño.</p>
            <div class="spacer-single"></div>
          </div>
        </div>
      </div>
      <div class="gradient-edge-bottom"></div>
    </section>

    <!-- ============ POSTS ============ -->
    <section>
      <div class="container">
        <div class="row g-4">
          {posts.map((post, i) => (
            <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay={delays[i % 3]}>
              <a href={post.href} class="d-block hover relative rounded-1 overflow-hidden text-light">
                <div class="relative">
                  <div class="abs end-0 z-2 bg-blur text-white p-3 pb-2 m-4 text-center fw-600">
                    <h4 class="fs-36 mb-0 lh-1">{post.day}</h4><span>{post.month}</span>
                  </div>
                </div>
                <img src={post.img} class="w-100 hover-scale-1-1" alt="" />
                <div class="absolute start-0 bottom-0 p-40 z-2">
                  <div class="bg-color rounded-1 p-0 px-2 d-inline-block mb-3">{post.cat}</div>
                  <h4>{post.title}</h4>
                </div>
                <div class="gradient-edge-bottom h-70"></div>
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ CTA ============ -->
    <section class="bg-color text-light pt-50 pb-50">
      <div class="container">
        <div class="row align-items-center">
          <div class="col-lg-8">
            <h3 class="mb-1 wow fadeInUp">¿Prefieres que lo instalemos contigo en tu negocio?</h3>
            <p class="mb-0 wow fadeInUp" data-wow-delay=".1s">Agenda una llamada gratuita y hablemos de tu detailing.</p>
          </div>
          <div class="col-lg-4 text-lg-end">
            <a class="btn-main fx-slide wow fadeInUp" href="/registro.html"><span>Agenda tu llamada</span></a>
          </div>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>
