---
// Header minimal para la VSL: sin nav, solo logo + CTA (menos fugas = más conversión)
---
<header class="transparent vsl-header">
  <div class="container">
    <div class="row">
      <div class="col-md-12">
        <div class="de-flex" style="align-items:center;">
          <div class="de-flex-col">
            <div id="logo">
              <a href="/index.html">
                <img class="logo-main" src="/images/logo-spacar.png" alt="SpaCar Academy" style="max-height:44px;width:auto;" />
                <img class="logo-scroll" src="/images/logo-spacar.png" alt="SpaCar Academy" style="max-height:44px;width:auto;" />
                <img class="logo-mobile" src="/images/logo-spacar.png" alt="SpaCar Academy" style="max-height:44px;width:auto;" />
              </a>
            </div>
          </div>
          <div class="de-flex-col">
            <a class="btn-main fx-slide" href="#agendar"><span>Quiero agendar mi llamada</span></a>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>
